{
  "name": "vscode-tokan",
  "displayName": "Tokan Enterprise Gateway",
  "description": "Routes IDE traffic to the enterprise Tokan gateway with live ROI metrics",
  "version": "0.1.0",
  "publisher": "tokan-enterprise",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokan.exportTerminalEnv",
        "title": "Tokan: Export Terminal Environment",
        "category": "Tokan"
      }
    ],
    "configuration": {
      "title": "Tokan Enterprise",
      "properties": {
        "tokan.gatewayUrl": {
          "type": "string",
          "default": "https://tokan.ai.internal.company.com/v1",
          "description": "Enterprise Tokan gateway endpoint"
        },
        "tokan.authToken": {
          "type": "string",
          "default": "",
          "description": "API auth token for gateway",
          "scope": "resource"
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "tokan.exportTerminalEnv", "group": "0@1" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
